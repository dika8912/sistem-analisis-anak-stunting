# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Salin file ini menjadi .env dan sesuaikan nilainya
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=stunting_db

# Set True hanya untuk development (akan print semua query SQL ke console)
DB_ECHO=False

# ── Machine Learning ──────────────────────────────────────────────────────────
# Path ke folder model .joblib hasil training
# Biarkan kosong untuk pakai default relatif dari project root
MODELS_DIR=

# ── JWT Authentication ────────────────────────────────────────────────────────
# WAJIB DIGANTI: gunakan string acak minimal 32 karakter di production
# Generate contoh: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti_dengan_secret_yang_sangat_panjang_dan_acak_minimal_32_karakter

# Algoritma JWT (jangan diubah kecuali ada keperluan khusus)
JWT_ALGORITHM=HS256

# Masa berlaku token dalam menit (default: 10080 = 7 hari)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
